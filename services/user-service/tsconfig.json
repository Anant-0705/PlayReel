{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "lib": [
            "ES2022"
        ],
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": false,
        "sourceMap": true,
        "resolveJsonModule": true,
        "baseUrl": "./src",
        "paths": {
            "../../../shared/*": [
                "../../shared/*"
            ],
            "../../../../shared/*": [
                "../../../shared/*"
            ]
        }
    },
    "include": [
        "src/**/*",
        "../../../shared/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts"
    ]
}