{
    "vhosts": [
        {
            "name": "/"
        }
    ],
    "users": [
        {
            "name": "gamereel",
            "password_hash": "",
            "hashing_algorithm": "rabbit_password_hashing_sha256",
            "tags": "administrator"
        }
    ],
    "permissions": [
        {
            "user": "gamereel",
            "vhost": "/",
            "configure": ".*",
            "write": ".*",
            "read": ".*"
        }
    ],
    "exchanges": [
        {
            "name": "game.events",
            "vhost": "/",
            "type": "topic",
            "durable": true,
            "auto_delete": false,
            "arguments": {}
        },
        {
            "name": "social.events",
            "vhost": "/",
            "type": "fanout",
            "durable": true,
            "auto_delete": false,
            "arguments": {}
        },
        {
            "name": "user.events",
            "vhost": "/",
            "type": "direct",
            "durable": true,
            "auto_delete": false,
            "arguments": {}
        },
        {
            "name": "dead.letter",
            "vhost": "/",
            "type": "direct",
            "durable": true,
            "auto_delete": false,
            "arguments": {}
        }
    ],
    "queues": [
        {
            "name": "game.processing",
            "vhost": "/",
            "durable": true,
            "auto_delete": false,
            "arguments": {
                "x-dead-letter-exchange": "dead.letter",
                "x-dead-letter-routing-key": "dead.letter.game.processing",
                "x-message-ttl": 86400000
            }
        },
        {
            "name": "notifications.push",
            "vhost": "/",
            "durable": true,
            "auto_delete": false,
            "arguments": {
                "x-dead-letter-exchange": "dead.letter",
                "x-dead-letter-routing-key": "dead.letter.notifications",
                "x-message-ttl": 3600000
            }
        },
        {
            "name": "feed.invalidation",
            "vhost": "/",
            "durable": true,
            "auto_delete": false,
            "arguments": {
                "x-dead-letter-exchange": "dead.letter",
                "x-dead-letter-routing-key": "dead.letter.feed",
                "x-message-ttl": 300000
            }
        },
        {
            "name": "follows",
            "vhost": "/",
            "durable": true,
            "auto_delete": false,
            "arguments": {
                "x-dead-letter-exchange": "dead.letter",
                "x-dead-letter-routing-key": "dead.letter.follows",
                "x-message-ttl": 3600000
            }
        },
        {
            "name": "moderation",
            "vhost": "/",
            "durable": true,
            "auto_delete": false,
            "arguments": {
                "x-dead-letter-exchange": "dead.letter",
                "x-dead-letter-routing-key": "dead.letter.moderation",
                "x-message-ttl": 86400000
            }
        },
        {
            "name": "dead.letter.queue",
            "vhost": "/",
            "durable": true,
            "auto_delete": false,
            "arguments": {}
        }
    ],
    "bindings": [
        {
            "source": "game.events",
            "vhost": "/",
            "destination": "game.processing",
            "destination_type": "queue",
            "routing_key": "game.submitted.#",
            "arguments": {}
        },
        {
            "source": "game.events",
            "vhost": "/",
            "destination": "feed.invalidation",
            "destination_type": "queue",
            "routing_key": "game.approved",
            "arguments": {}
        },
        {
            "source": "game.events",
            "vhost": "/",
            "destination": "notifications.push",
            "destination_type": "queue",
            "routing_key": "game.published",
            "arguments": {}
        },
        {
            "source": "game.events",
            "vhost": "/",
            "destination": "notifications.push",
            "destination_type": "queue",
            "routing_key": "game.rejected",
            "arguments": {}
        },
        {
            "source": "game.events",
            "vhost": "/",
            "destination": "moderation",
            "destination_type": "queue",
            "routing_key": "game.flagged",
            "arguments": {}
        },
        {
            "source": "social.events",
            "vhost": "/",
            "destination": "notifications.push",
            "destination_type": "queue",
            "routing_key": "",
            "arguments": {}
        },
        {
            "source": "social.events",
            "vhost": "/",
            "destination": "feed.invalidation",
            "destination_type": "queue",
            "routing_key": "",
            "arguments": {}
        },
        {
            "source": "user.events",
            "vhost": "/",
            "destination": "follows",
            "destination_type": "queue",
            "routing_key": "user.followed",
            "arguments": {}
        },
        {
            "source": "dead.letter",
            "vhost": "/",
            "destination": "dead.letter.queue",
            "destination_type": "queue",
            "routing_key": "#",
            "arguments": {}
        }
    ]
}