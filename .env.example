# ============================================================
# GameReel — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gamereel
POSTGRES_USER=gamereel
POSTGRES_PASSWORD=changeme_db_password

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password

# ── RabbitMQ ─────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=gamereel
RABBITMQ_PASSWORD=changeme_rabbit_password
RABBITMQ_VHOST=/

# ── MinIO ────────────────────────────────────────────────────
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=gamereel_access
MINIO_SECRET_KEY=changeme_minio_secret
MINIO_BUCKET=game-assets
MINIO_PUBLIC_URL=http://localhost:9000

# ── Elasticsearch ────────────────────────────────────────────
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=games

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=changeme_jwt_secret_minimum_32_characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=changeme_refresh_secret_minimum_32_characters
JWT_REFRESH_EXPIRES_IN=30d

# ── Firebase Cloud Messaging ─────────────────────────────────
# Download from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ── Upload Service ───────────────────────────────────────────
UPLOAD_MAX_SIZE_BYTES=209715200
UPLOAD_CHUNK_SIZE_BYTES=5242880
UPLOAD_MAX_PER_DAY=10
UPLOAD_MAX_CONCURRENT=5

# ── Service URLs (internal) ──────────────────────────────────
USER_SERVICE_URL=http://user-service:3001
GAME_SERVICE_URL=http://game-service:3002
FEED_SERVICE_URL=http://feed-service:3003
SOCIAL_SERVICE_URL=http://social-service:3004
UPLOAD_SERVICE_URL=http://upload-service:3005

# ── Node Environment ─────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── Nginx ────────────────────────────────────────────────────
NGINX_PORT=80
